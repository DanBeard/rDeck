{
  "options": {
    "paths": {
      "root": "/data",
      "mbtiles": "/data/mbtiles"
    },
    "serveAllStyles": true
  },
  "data": {
    "v3": {
      "mbtiles": "tiles.mbtiles"
    }
  },
  "styles": {
